# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Outputs & Cache
/.next/
/out/
/build
/dist
.turbo/

# Testing & Coverage
/coverage

# Environment & Secrets (NEVER push credentials to GitHub)
.env
.env*.local
.env.development
.env.test
.env.production
!.env.example
!.env.template

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
thumbs.db
[Dd]esktop.ini

# IDE & Editor Specific Files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
.cursor/
.windsurf/
*.swp
*.swo
*~

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Vercel Deployment Metadata
.vercel

# TypeScript Cache
*.tsbuildinfo
next-env.d.ts

# Security Certificates & Keys
*.pem
*.key
*.cert
*.crt

# Temporary & Scratch Files
tmp/
temp/
*.tmp
*.bak
